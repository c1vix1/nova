import keyring

# Store the API token securely
keyring.set_password('classroom-api', 'calvin.yu10@stu.austinisd.org', 'Compbuild24!')

# Retrieve the stored API token
api_token = keyring.get_password('classroom-api', 'calvin.yu10@stu.austinisd.org')

if not api_token:
    raise ValueError("No API token found in the keyring.")

print(f'Using API token: {api_token}')